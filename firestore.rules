rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Safety fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure isolated user path
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.startsWith("bypass_");
      
      match /{allSubcollections=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.startsWith("bypass_");
      }
    }
  }
}
