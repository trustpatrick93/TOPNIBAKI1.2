rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User document and personal data isolation
    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /diary_entries/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(entryId);
      }

      match /weekly_tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      match /monthly_events/{eventId} {
        allow read, write: if isOwner(userId) && isValidId(eventId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) && isValidId(categoryId);
      }
    }
  }
}
